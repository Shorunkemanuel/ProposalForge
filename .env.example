# ProposalForge provider configuration.
#
# The application reads these variables directly from the process
# environment; it does NOT load a .env file automatically. All of these are
# optional: you can start with none of them set and configure everything in
# the app's "AI provider setup" card.
#
# The primary setup is a hosted OpenAI-compatible endpoint with your own API
# key (BYOK), for example OpenRouter:
#
#   export PROPOSALFORGE_PROVIDER=openrouter
#   export PROPOSALFORGE_MODEL=openrouter/free
#   export PROPOSALFORGE_API_KEY=<your-own-openrouter-key>
#
# Running a local inference server yourself is optional, not required.
# Each provider expects the key issued by that provider; a key from one
# provider does not work with another. Placeholder values only. Never commit
# real secrets.

# Provider preset. One of: openrouter, openai, gemini, ollama-cloud, custom,
# ollama. Hosted BYOK is the default: leaving this unset uses "openrouter".
#   openrouter    https://openrouter.ai/api/v1  (default)
#   openai        https://api.openai.com/v1
#   gemini        https://generativelanguage.googleapis.com/v1beta/openai/
#   ollama-cloud  https://ollama.com/v1
#   custom        any OpenAI-compatible endpoint you supply
#   ollama        native local API (http://127.0.0.1:11434)
PROPOSALFORGE_PROVIDER=openrouter

# Compatible API base URL. If unset, it defaults to the selected preset's
# documented URL. Set it only to override that (for example your own gateway
# at https://api.example.com/v1). A local server such as
# http://127.0.0.1:11434 uses the "ollama" preset.
PROPOSALFORGE_BASE_URL=

# Model identifier. Required to generate a proposal. Verify the exact name
# your provider offers before relying on it. For OpenRouter's automatic
# routing, use "openrouter/free".
PROPOSALFORGE_MODEL=

# Optional bearer token for a hosted endpoint (BYOK). Your own key; it is
# sent only to the configured provider, held in memory for the running
# server, and never returned to the browser or written to disk. Leave empty
# for a loopback endpoint that does not require authentication.
PROPOSALFORGE_API_KEY=

# Request timeout in seconds. This bounds a single generation request; on a
# CPU-only local model a full proposal can take minutes, so the default is
# generous (600s). Fast model-discovery/connection probes are capped shorter
# (10s) server-side regardless of this value.
PROPOSALFORGE_TIMEOUT=600
