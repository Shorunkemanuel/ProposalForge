# ProposalForge provider configuration.
#
# The application reads these variables directly from the process
# environment; it does NOT load a .env file automatically. Export the
# values in your shell or Codespaces environment, for example:
#
#   export PROPOSALFORGE_MODEL=qwen2.5:0.5b-instruct-q4_K_M
#
# Placeholder values only. Never commit real secrets.

# Provider kind. Only "ollama" (Ollama-compatible chat API) is supported.
PROPOSALFORGE_PROVIDER=ollama

# Endpoint base URL. Defaults to a local Ollama server on localhost.
PROPOSALFORGE_BASE_URL=http://127.0.0.1:11434

# Model name. Required to generate a proposal. Verify it exists on the
# configured endpoint before relying on it.
PROPOSALFORGE_MODEL=

# Optional bearer token for a hosted Ollama-compatible endpoint. Leave
# empty for a local server that does not require authentication.
PROPOSALFORGE_API_KEY=

# Request timeout in seconds.
PROPOSALFORGE_TIMEOUT=60
